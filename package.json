{
  "name": "videoadjust",
  "version": "0.22.18",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:licenses && tsc --noEmit && vite build && pnpm check:remote",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node scripts/check-size.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:remote": "node scripts/check-no-remote.mjs"
  },
  "dependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/merriweather": "5.3.0",
    "@mediabunny/aac-encoder": "1.62.0",
    "@mediabunny/mp3-encoder": "1.62.0",
    "gifenc": "1.0.3",
    "mediabunny": "1.62.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
